# ==============================================================================
# MeetWhisper Environment Configuration
# ==============================================================================

# Application & Server
ENVIRONMENT=development
DEBUG=true
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=250

# Database & Cache
# For local docker-compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meetwhisper
# In-memory or file-based for local tests:
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=redis://localhost:6379/0

# Speech Recognition & Diarization
# Options: faster_whisper | groq | deepgram | mock
TRANSCRIBER_ENGINE=faster_whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Diarization (Optional pyannote.audio fallback)
ENABLE_DIARIZATION=false
HF_TOKEN=

# API-based Transcribers (if TRANSCRIBER_ENGINE=groq or deepgram)
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Semantic Topic Segmentation
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Structured Intelligence & Graph Extraction
# Options: gemini | openai | ollama | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
